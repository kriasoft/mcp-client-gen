{
  "name": "mcp-client-gen",
  "version": "0.0.5",
  "description": "Generate type-safe TypeScript clients from MCP (Model Context Protocol) servers",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./internal": "./dist/internal.js"
  },
  "bin": {
    "mcp-client-gen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "codegen",
    "generator",
    "client",
    "sdk",
    "cli",
    "type-safe",
    "api-client",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "author": "Konstantin Tarkus <koistya@kriasoft.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/koistya",
  "repository": {
    "type": "git",
    "url": "https://github.com/kriasoft/mcp-client-gen.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/kriasoft/mcp-client-gen",
  "bugs": {
    "url": "https://github.com/kriasoft/mcp-client-gen/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "oauth-callback": "^2.2.0",
    "open": "^11.0.0",
    "ts-morph": "^27.0.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@types/bun": "1.3.6",
    "dotenv": "^17.2.3",
    "prettier": "^3.8.1",
    "srcpack": "^0.1.14",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "endOfLine": "lf"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --sourcemap",
    "clean": "rm -rf dist",
    "test": "bun test src",
    "test:e2e": "bun test test/e2e",
    "test:all": "bun test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "validate": "bun run format:check && bun run typecheck && bun run test:all",
    "capture:notion": "bun run test/manual/capture-notion.ts",
    "smoke:notion": "bun run test/manual/smoke-notion.ts",
    "e2e:notion": "bun run test/manual/e2e-notion.ts",
    "prepublishOnly": "bun run build"
  }
}
