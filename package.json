{
  "name": "mcp-client-gen",
  "version": "0.2.0",
  "description": "Generate type-safe TypeScript clients from MCP (Model Context Protocol) servers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-client-gen": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "codegen",
    "generator",
    "client",
    "sdk",
    "cli",
    "type-safe",
    "api-client",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "author": "Konstantin Tarkus <koistya@kriasoft.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/koistya",
  "repository": {
    "type": "git",
    "url": "https://github.com/kriasoft/mcp-client-gen.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/kriasoft/mcp-client-gen",
  "bugs": {
    "url": "https://github.com/kriasoft/mcp-client-gen/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/client": "~2.2.0",
    "oauth-callback": "^3.0.0",
    "prettier": "^3.9.9",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@types/bun": "1.4.2",
    "dotenv": "^18.0.5",
    "srcpack": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": false,
    "endOfLine": "lf"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/cli.ts src/index.ts --outdir dist --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "bun test --isolate src",
    "test:e2e": "bun test --isolate test/e2e",
    "test:all": "bun test --isolate",
    "typecheck": "bun tsc -p tsconfig.json --noEmit",
    "format": "bun prettier --write .",
    "format:check": "bun prettier --check .",
    "validate": "bun run format:check && bun run typecheck && bun run test:all",
    "capture:notion": "bun run test/manual/capture-notion.ts",
    "smoke:notion": "bun run test/manual/smoke-notion.ts",
    "e2e:notion": "bun run test/manual/e2e-notion.ts",
    "smoke:package": "bun run test/package-smoke.ts",
    "prepublishOnly": "bun run validate && bun run build && bun run smoke:package"
  }
}
